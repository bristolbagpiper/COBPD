rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberRecordExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function memberRecord() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isAdminMember() {
      return memberRecordExists() &&
        memberRecord().data.active == true &&
        memberRecord().data.admin == true;
    }

    function canReadMembersArea() {
      return isSignedIn();
    }

    match /members/{memberId} {
      allow get, list: if canReadMembersArea();
      allow write: if false;
    }

    match /gigs/{gigId} {
      allow get, list: if canReadMembersArea();
      allow create, update: if isAdminMember();
      allow delete: if false;
    }

    match /responses/{responseId} {
      allow get, list: if canReadMembersArea();
      allow create, update: if canReadMembersArea() &&
        request.resource.data.memberId == request.auth.uid &&
        request.resource.data.gigId is string &&
        request.resource.data.answer in ["yes", "no", "maybe"];
      allow delete: if false;
    }
  }
}
